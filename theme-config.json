{
    "name": "Amoled Theme",
    "metas": {
        "betterdiscord": "clients/metas/betterdiscord.json",
        "userstyle": "clients/metas/userstyle.json"
    },
    "import": "https://cdn.jsdelivr.net/gh/zacjmurphy/Amoled-Theme@main/src/amoled-theme.css",
    "dist": {
        "output": "src/amoled-theme.css",
        "clients": {
            "compileFor": ["betterdiscord", "userstyle"]
        }
    },
    "dev": {
        "mod": "vencord",
        "target": "src/dev.scss"
    }
}